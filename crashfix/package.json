{
  "name": "crashfix",
  "version": "0.1.0",
  "description": "Automated Crashlytics crash/ANR fix pipeline for Android/KMP repos",
  "keywords": ["crashlytics", "firebase", "android", "kmp", "claude", "agent"],
  "type": "module",
  "bin": { "crashfix": "dist/cli.js" },
  "files": ["dist"],
  "repository": { "type": "git", "url": "git+https://github.com/OWNER/crashfix.git" },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.251",
    "@anthropic-ai/sdk": "0.122.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "commander": "15.0.0",
    "zod": "4.5.2",
    "execa": "10.0.1",
    "ink": "7.1.1",
    "react": "19.2.0"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "tsx": "4.19.2",
    "vitest": "4.1.11",
    "ink-testing-library": "4.0.0",
    "@types/react": "19.2.0",
    "@types/node": "22.10.2"
  }
}
